{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@agentjam/core": ["packages/core/src/index.ts"],
      "@agentjam/parser": ["packages/parser/src/index.ts"],
      "@agentjam/validator": ["packages/validator/src/index.ts"],
      "@agentjam/registry": ["packages/registry/src/index.ts"],
      "@agentjam/adapters": ["packages/adapters/src/index.ts"],
      "@agentjam/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@agentjam/runtime": ["packages/runtime/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
